{
  "name": "deckdock-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "JOBS_AUTORUN=true node scripts/next.mjs dev",
    "dev:setup": "node scripts/dev-setup.mjs",
    "build": "next build",
    "start": "JOBS_AUTORUN=true node scripts/next.mjs start",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "db:start": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "payload": "node --import tsx node_modules/payload/bin.js --disable-transpile",
    "generate:types": "pnpm payload generate:types",
    "generate:importmap": "pnpm payload generate:importmap",
    "admin:reset-password": "pnpm payload run src/scripts/reset-admin-password.ts",
    "admin:create": "pnpm payload run src/scripts/create-admin.ts",
    "db:seed": "pnpm payload run src/scripts/seed.ts",
    "db:migrate": "pnpm payload migrate",
    "db:migrate:create": "pnpm payload migrate:create",
    "db:migrate:status": "pnpm payload migrate:status",
    "test": "node tests/run.mjs",
    "test:unit": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ui:add": "shadcn add",
    "module:remove": "node --import tsx scripts/remove-module.mjs",
    "starter:update": "node scripts/starter-update.mjs update",
    "starter:add": "node scripts/starter-update.mjs add"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "16.6.1",
    "graphql": "16.11.0",
    "kysely": "0.29.9",
    "lucide-react": "^1.61.0",
    "next": "16.4.6",
    "nodemailer": "^10.2.1",
    "payload": "3.90.2",
    "payload-totp": "3.0.7",
    "pg": "8.20.0",
    "pino": "9.14.0",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.91.0",
    "sharp": "0.35.5",
    "stripe": "^23.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "jsdom": "^30.1.3",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "shadcn": "4.22.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
