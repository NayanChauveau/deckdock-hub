{
  "slug": "deckdock-hub",
  "identity": {
    "displayName": "DeckDock",
    "domain": "deckdock-hub.invalid",
    "locales": ["fr", "en"],
    "defaultLocale": "fr"
  },
  "app": { "port": 3400, "logService": "deckdock-hub", "userAgent": "deckdock-hub/0.1" },
  "modules": { "decks": { "maxUploadBytes": 104857600 } },
  "deploy": {
    "directory": "/srv/deckdock-hub",
    "composeProject": "deckdock-hub-prod",
    "imageRepository": "ghcr.io/nayanchauveau/deckdock-hub",
    "volumeOwnerLabel": "deckdock-hub.owner",
    "volumes": {
      "database": "deckdock-hub-prod-pgdata",
      "media": "deckdock-hub-prod-media",
      "legacyDatabase": null
    },
    "database": { "name": "deckdock_hub", "user": "deckdock_hub" },
    "traefikName": "deckdock-hub",
    "defaultHost": "deckdock-hub.invalid",
    "protectedHosts": [
      "fontus.fr",
      "www.fontus.fr",
      "manonkarsenti.com",
      "www.manonkarsenti.com",
      "manon.fontus.fr"
    ],
    "protectedHealthUrl": "https://manonkarsenti.com/api/health",
    "opsJobs": ["migrate", "bootstrap-admin"],
    "requiredSecrets": ["POSTGRES_PASSWORD", "PAYLOAD_SECRET", "BETTER_AUTH_SECRET"],
    "optionalSecrets": ["GOOGLE_MAPS_API_KEY"],
    "payments": false,
    "email": true,
    "quietWindow": true,
    "wwwRedirect": false
  },
  "analytics": null,
  "smoke": {
    "pages": [{ "path": "/fr", "contains": "Le site ouvre très bientôt" }],
    "extension": "deploy/smoke_site.py"
  },
  "github": {
    "secrets": [
      "ADMIN_RESET_PASSWORD",
      "BETTER_AUTH_SECRET",
      "BOOTSTRAP_ADMIN_EMAIL",
      "BOOTSTRAP_ADMIN_NAME",
      "BOOTSTRAP_ADMIN_PASSWORD",
      "GOOGLE_MAPS_API_KEY",
      "PAYLOAD_SECRET",
      "POSTGRES_PASSWORD",
      "SMTP_URL",
      "SSH_HOST",
      "SSH_KEY",
      "SSH_KNOWN_HOSTS",
      "SSH_PASSPHRASE",
      "SSH_PASSWORD",
      "SSH_PORT",
      "SSH_USER",
      "STRIPE_LIVE_SECRET_KEY",
      "STRIPE_LIVE_WEBHOOK_SECRET",
      "STRIPE_TEST_SECRET_KEY",
      "STRIPE_TEST_WEBHOOK_SECRET"
    ],
    "variables": [
      "EMAIL_FROM",
      "EMAIL_MODE",
      "EMAIL_REPLY_TO",
      "PRODUCTION_ALIASES",
      "PRODUCTION_DEPLOY_ENABLED",
      "PRODUCTION_HOST",
      "PUBLIC_INDEXING",
      "STRIPE_MODE",
      "VPS_IPV4"
    ]
  }
}
