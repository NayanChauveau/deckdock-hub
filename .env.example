DATABASE_URL=postgresql://example:example_local_only@127.0.0.1:5434/example_dev
PAYLOAD_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# BETTER_AUTH_SECRET: visitor accounts (accounts module). Required in production (32 characters at least, openssl rand -hex 32);
# empty here: Better Auth uses its development default.
BETTER_AUTH_SECRET=
APP_URL=http://localhost:3300

# Dossier persistant des images publiques (hors dépôt)
MEDIA_DIR=storage/media

# Deux jeux de clés indépendants ; test par défaut. Le mode live accepte de vrais paiements.
# En local sans clés : simulated. En production : stripe (jamais simulated).
COMMERCE_PAYMENT_MODE=simulated
STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# Emails visibles dans l’admin sans envoi réel. SMTP facultatif pour la suite.
EMAIL_MODE=simulated
SMTP_URL=
EMAIL_FROM=
# Recherche d’adresse (Google Places API (New)) : facultative, le formulaire reste utilisable à la main.
GOOGLE_MAPS_API_KEY=
