DATABASE_URL=postgresql://deckdock_hub:deckdock_hub_local_only@127.0.0.1:5435/deckdock_hub_dev
PAYLOAD_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# BETTER_AUTH_SECRET: visitor accounts (accounts module). Required in production (32 characters at least, openssl rand -hex 32);
# empty here: Better Auth uses its development default.
BETTER_AUTH_SECRET=
APP_URL=http://localhost:3400

# Dossier persistant des images publiques (hors dépôt)
MEDIA_DIR=storage/media

# DeckDock hub: uploaded decks (blobs, temporary uploads), and the deckdock checker run by the
# publish API. HUB_PYTHON must be Python >= 3.13 (python3 by default); HUB_MAX_UPLOAD_BYTES
# overrides modules.decks.maxUploadBytes of site.config.json.
HUB_DATA_DIR=storage/hub
PYTHONPATH=vendor/deckdock
HUB_PYTHON=python3.13

# Emails visibles dans l’admin sans envoi réel. SMTP facultatif pour la suite.
EMAIL_MODE=simulated
SMTP_URL=
EMAIL_FROM=
